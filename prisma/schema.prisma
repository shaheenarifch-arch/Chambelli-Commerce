generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  OUT_OF_STOCK
  ARCHIVED
}

enum SupplierType {
  CJ
  OWNED
  FUTURE
}

enum EventType {
  CAROUSEL_LOAD
  IMPRESSION
  CLICK
  VIEW_PRODUCT
  ADD_TO_CART
  CHECKOUT
  PURCHASE
}

model Website {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  domain      String              @unique
  category    String
  market      String
  currency    String              @default("USD")
  active      Boolean             @default(true)
  assignments ProductAssignment[]
  placements  CarouselPlacement[]
  events      AnalyticsEvent[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model Supplier {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  type      SupplierType
  active    Boolean           @default(true)
  products  SupplierProduct[]
  createdAt DateTime          @default(now())
}

model Product {
  id               String              @id @default(uuid())
  sku              String              @unique
  slug             String              @unique
  title            String
  description      String?
  imageUrl         String?
  category         String
  tags             String[]
  supplierType     SupplierType
  status           ProductStatus       @default(DRAFT)
  variants         ProductVariant[]
  supplierProducts SupplierProduct[]
  assignments      ProductAssignment[]
  score            ProductScore?
  events           AnalyticsEvent[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([status, category])
}

model ProductVariant {
  id             String              @id @default(uuid())
  productId      String
  sku            String              @unique
  name           String
  cost           Decimal             @db.Decimal(12, 2)
  shippingCost   Decimal             @default(0) @db.Decimal(12, 2)
  price          Decimal             @db.Decimal(12, 2)
  compareAtPrice Decimal?            @db.Decimal(12, 2)
  currency       String              @default("USD")
  quantity       Int                 @default(0)
  safetyBuffer   Int                 @default(0)
  warehouse      String?
  active         Boolean             @default(true)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  snapshots      InventorySnapshot[]

  @@index([productId, active])
}

model SupplierProduct {
  id                String    @id @default(uuid())
  supplierId        String
  productId         String
  supplierProductId String
  supplierSku       String
  supplierPrice     Decimal   @db.Decimal(12, 2)
  supplierStock     Int       @default(0)
  warehouse         String?
  country           String?
  raw               Json?
  lastSyncAt        DateTime?
  supplier          Supplier  @relation(fields: [supplierId], references: [id])
  product           Product   @relation(fields: [productId], references: [id])

  @@unique([supplierId, supplierProductId])
  @@unique([supplierId, supplierSku])
}

model InventorySnapshot {
  id               String         @id @default(uuid())
  variantId        String
  quantity         Int
  sellableQuantity Int
  source           String
  createdAt        DateTime       @default(now())
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

model PricingRule {
  id                   String        @id @default(uuid())
  name                 String
  category             String?
  supplierType         SupplierType?
  markupPercent        Decimal       @db.Decimal(7, 2)
  minimumMarginPercent Decimal       @default(15) @db.Decimal(7, 2)
  active               Boolean       @default(true)
  createdAt            DateTime      @default(now())
}

model ProductAssignment {
  id        String    @id @default(uuid())
  productId String
  websiteId String
  placement String    @default("article-footer")
  priority  Int       @default(50)
  weight    Float     @default(1)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([productId, websiteId, placement])
  @@index([websiteId, placement, active])
}

model CarouselPlacement {
  id        String  @id @default(uuid())
  websiteId String
  key       String
  title     String  @default("Recommended Products")
  limit     Int     @default(30)
  active    Boolean @default(true)
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, key])
}

model AnalyticsEvent {
  id        String    @id @default(uuid())
  websiteId String
  productId String?
  eventType EventType
  sessionId String?
  placement String?
  position  Int?
  metadata  Json?
  createdAt DateTime  @default(now())
  website   Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([websiteId, eventType, createdAt])
  @@index([productId, eventType, createdAt])
}

model ProductScore {
  id             String   @id @default(uuid())
  productId      String   @unique
  ctr            Float    @default(0)
  conversionRate Float    @default(0)
  profitScore    Float    @default(0)
  relevanceScore Float    @default(0)
  inventoryScore Float    @default(0)
  finalScore     Float    @default(0)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  updatedAt      DateTime @updatedAt
}

model SyncJob {
  id          String    @id @default(uuid())
  supplierId  String?
  type        String
  status      String
  cursor      String?
  processed   Int       @default(0)
  failures    Int       @default(0)
  details     Json?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, startedAt])
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  VALIDATION_REQUIRED
  READY_FOR_FULFILLMENT
  SUBMITTED_TO_SUPPLIER
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLATION_REQUESTED
  CANCELED
  REFUND_REQUESTED
  REFUNDED
  FULFILLMENT_EXCEPTION
}

enum PaymentProvider {
  STRIPE
  PAYPAL
}

enum PaymentStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentProvider {
  CJ
  INTERNAL
}

enum PromotionType {
  PERCENT
  FIXED
  FREE_SHIPPING
}

model Customer {
  id        String    @id @default(uuid())
  email     String    @unique
  name      String?
  phone     String?
  carts     Cart[]
  orders    Order[]
  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id         String    @id @default(uuid())
  customerId String?
  name       String
  line1      String
  line2      String?
  city       String
  region     String?
  postalCode String
  country    String
  phone      String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]
  createdAt  DateTime  @default(now())
}

model Cart {
  id         String     @id @default(uuid())
  websiteId  String
  customerId String?
  sessionId  String
  status     CartStatus @default(ACTIVE)
  currency   String
  items      CartItem[]
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([sessionId, status])
  @@index([customerId, status])
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       String        @unique
  websiteId         String
  customerId        String?
  shippingAddressId String
  status            OrderStatus   @default(PENDING_PAYMENT)
  currency          String
  subtotal          Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(12, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  idempotencyKey    String        @unique
  customer          Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress   Address       @relation(fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  fulfillments      Fulfillment[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([websiteId, status, createdAt])
}

model OrderItem {
  id                String       @id @default(uuid())
  orderId           String
  productId         String
  variantId         String
  title             String
  sku               String
  quantity          Int
  unitPrice         Decimal      @db.Decimal(12, 2)
  unitCost          Decimal      @db.Decimal(12, 2)
  supplierType      SupplierType
  supplierProductId String?
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id                String          @id @default(uuid())
  orderId           String
  provider          PaymentProvider
  providerPaymentId String?
  status            PaymentStatus   @default(CREATED)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String
  idempotencyKey    String          @unique
  metadata          Json?
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([provider, providerPaymentId])
}

model Fulfillment {
  id              String              @id @default(uuid())
  orderId         String
  provider        FulfillmentProvider
  status          String
  supplierOrderId String?
  trackingNumber  String?
  trackingUrl     String?
  carrier         String?
  requestPayload  Json?
  responsePayload Json?
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([orderId, status])
}

model Promotion {
  id              String        @id @default(uuid())
  code            String        @unique
  name            String
  type            PromotionType
  value           Decimal       @db.Decimal(12, 2)
  active          Boolean       @default(true)
  minimumSubtotal Decimal?      @db.Decimal(12, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  maxUses         Int?
  uses            Int           @default(0)
  createdAt       DateTime      @default(now())
}

model ReturnRequest {
  id             String   @id @default(uuid())
  orderId        String
  reason         String
  status         String   @default("REQUESTED")
  requestedItems Json
  refundAmount   Decimal? @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([orderId, status])
}
