# --- Core ---
DATABASE_URL=postgresql://chambelli:chambelli@localhost:5432/chambelli
REDIS_URL=redis://localhost:6379
PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080

# Admin API key: at least 24 characters. Admin endpoints refuse all requests until set.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API. Leave empty to allow any
# origin (needed while the widget is embedded on many sites).
CORS_ORIGINS=
# Set to true when running behind Cloudflare or another proxy (real client IPs for rate limits).
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300

# --- CJ Dropshipping ---
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# CJ access tokens expire; refresh this value when CJ issues a new one.
CJ_ACCESS_TOKEN=
CJ_SYNC_MAX_PAGES=50

# --- Integrations ---
POSTHOG_KEY=
POSTHOG_HOST=
RAMBO_URL=
RAMBO_API_KEY=

# --- Payments (use sandbox credentials until launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=
