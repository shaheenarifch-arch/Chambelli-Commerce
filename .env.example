# --- Core ---
DATABASE_URL=postgresql://chambelli:chambelli@localhost:5432/chambelli
REDIS_URL=redis://localhost:6379
PORT=8080
PUBLIC_API_BASE_URL=http://localhost:8080

# Admin API key: at least 24 characters. Admin endpoints refuse all requests until set.
# Generate one with: openssl rand -hex 32
ADMIN_API_KEY=

# Comma-separated browser origins allowed to call the API. Leave empty to allow any
# origin (needed while the widget is embedded on many sites).
CORS_ORIGINS=
# Set to true when running behind Cloudflare or another proxy (real client IPs for rate limits).
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300

# --- CJ Dropshipping ---
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# CJ access tokens expire; refresh this value when CJ issues a new one.
CJ_ACCESS_TOKEN=
CJ_SYNC_MAX_PAGES=50

# --- Canada chapter (Chambelli Canada storefront at agent.getservices.ai/ca) ---
# Turn on the Canadian-warehouse sync. The Canada pass is skipped until the two values below are set.
CJ_SYNC_CANADA=false
CJ_SYNC_CANADA_MAX_PAGES=20
# USD to CAD rate used to convert CJ costs (e.g. 1.38). Update it when the rate moves.
USD_TO_CAD_RATE=
# Average CJ shipping cost inside Canada, in CAD, built into every Canadian price.
CA_SHIPPING_ESTIMATE_CAD=
# Minimum margin on Canadian prices, in percent.
CA_MIN_MARGIN_PERCENT=30
# Set to true only after registering for GST/HST with the CRA; until then no tax is charged.
# Help: https://www.canada.ca/en/revenue-agency/services/tax/businesses/topics/gst-hst-businesses/when-register-charge.html
CA_GST_HST_REGISTERED=false

# --- UK chapter (Chambelli UK: GB-warehouse stock, prices in GBP). Help: docs/UK.md ---
# Turn on the UK-warehouse sync. The UK pass is skipped until the two values below are set.
CJ_SYNC_UK=false
CJ_SYNC_UK_MAX_PAGES=20
# USD to GBP rate used to convert CJ costs (e.g. 0.79). Update it when the rate moves.
USD_TO_GBP_RATE=
# Average CJ delivery cost inside the UK, in GBP, built into every UK price.
UK_SHIPPING_ESTIMATE_GBP=
# Minimum margin on UK prices (before VAT), in percent.
UK_MIN_MARGIN_PERCENT=30
# VAT added to UK prices, in percent. Keep 0 until you are VAT-registered, then set 20.
# Help: https://www.gov.uk/vat-registration
UK_VAT_PERCENT=0

# --- Germany chapter (Chambelli Germany: DE-warehouse stock, prices in EUR). Help: docs/DE.md ---
# Turn on the Germany-warehouse sync. The Germany pass is skipped until the two values below are set.
CJ_SYNC_DE=false
CJ_SYNC_DE_MAX_PAGES=20
# USD to EUR rate used to convert CJ costs (e.g. 0.92). Update it when the rate moves.
USD_TO_EUR_RATE=
# Average CJ delivery cost inside Germany, in EUR, built into every German price.
DE_SHIPPING_ESTIMATE_EUR=
# Minimum margin on German prices (before VAT), in percent.
DE_MIN_MARGIN_PERCENT=30
# VAT added to German prices, in percent. Keep 0 until you are registered for EU VAT, then set 19.
# Help: https://vat-one-stop-shop.ec.europa.eu/index_en
DE_VAT_PERCENT=0

# --- Integrations ---
POSTHOG_KEY=
POSTHOG_HOST=
RAMBO_URL=
RAMBO_API_KEY=

# --- Payments (use sandbox credentials until launch) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=

# --- Website carousels (30 to 50 CJ products per site; dashboard: /carousels) ---
# CJ US shipping per unit in USD, built into every site price (30% margin floor).
# Approving products stays off until this is set.
SITE_US_SHIPPING_COST=

# --- Amazon control (Love$Care on Amazon US, Canada, Mexico) ---
# Dashboard: /amazon. Each country is set separately; leave a value empty to keep that check off.
# CJ shipping cost per unit, in the marketplace currency (turns price/margin checks on).
AMAZON_US_SHIPPING_COST=
AMAZON_CA_SHIPPING_COST=
AMAZON_MX_SHIPPING_COST=
# USD -> CAD / MXN rate for CJ costs (Canada and Mexico only).
AMAZON_CA_USD_RATE=
AMAZON_MX_USD_RATE=
# CJ shipping method used by "Order from CJ" (the logistic name CJ shows at checkout).
AMAZON_US_CJ_LOGISTIC=
AMAZON_CA_CJ_LOGISTIC=
AMAZON_MX_CJ_LOGISTIC=
# Optional overrides (defaults shown): margin 30, Amazon fee 15, max qty 10, held-back units 2,
# stock counted from the same country's CJ warehouse.
# AMAZON_US_MIN_MARGIN_PERCENT=30
# AMAZON_US_REFERRAL_FEE_PERCENT=15
# AMAZON_US_MAX_QUANTITY=10
# AMAZON_US_STOCK_BUFFER=2
# AMAZON_CA_STOCK_COUNTRY=CA
