generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }
enum ProductStatus { DRAFT PENDING_REVIEW ACTIVE PAUSED OUT_OF_STOCK ARCHIVED }
enum SupplierType { CJ OWNED FUTURE }
enum EventType { CAROUSEL_LOAD IMPRESSION CLICK VIEW_PRODUCT ADD_TO_CART CHECKOUT PURCHASE }
model Website { id String @id @default(uuid()); name String; slug String @unique; domain String @unique; category String; market String; currency String @default("USD"); active Boolean @default(true); assignments ProductAssignment[]; placements CarouselPlacement[]; events AnalyticsEvent[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Supplier { id String @id @default(uuid()); name String; slug String @unique; type SupplierType; active Boolean @default(true); products SupplierProduct[]; createdAt DateTime @default(now()) }
model Product { id String @id @default(uuid()); sku String @unique; slug String @unique; title String; description String?; imageUrl String?; category String; tags String[]; supplierType SupplierType; status ProductStatus @default(DRAFT); variants ProductVariant[]; supplierProducts SupplierProduct[]; assignments ProductAssignment[]; score ProductScore?; events AnalyticsEvent[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([status,category]) }
model ProductVariant { id String @id @default(uuid()); productId String; sku String @unique; name String; cost Decimal @db.Decimal(12,2); shippingCost Decimal @default(0) @db.Decimal(12,2); price Decimal @db.Decimal(12,2); compareAtPrice Decimal? @db.Decimal(12,2); currency String @default("USD"); quantity Int @default(0); safetyBuffer Int @default(0); warehouse String?; active Boolean @default(true); product Product @relation(fields:[productId],references:[id],onDelete:Cascade); snapshots InventorySnapshot[]; @@index([productId,active]) }
model SupplierProduct { id String @id @default(uuid()); supplierId String; productId String; supplierProductId String; supplierSku String; supplierPrice Decimal @db.Decimal(12,2); supplierStock Int @default(0); warehouse String?; country String?; raw Json?; lastSyncAt DateTime?; supplier Supplier @relation(fields:[supplierId],references:[id]); product Product @relation(fields:[productId],references:[id]); @@unique([supplierId,supplierProductId]); @@unique([supplierId,supplierSku]) }
model InventorySnapshot { id String @id @default(uuid()); variantId String; quantity Int; sellableQuantity Int; source String; createdAt DateTime @default(now()); variant ProductVariant @relation(fields:[variantId],references:[id],onDelete:Cascade); @@index([variantId,createdAt]) }
model PricingRule { id String @id @default(uuid()); name String; category String?; supplierType SupplierType?; markupPercent Decimal @db.Decimal(7,2); minimumMarginPercent Decimal @default(15) @db.Decimal(7,2); active Boolean @default(true); createdAt DateTime @default(now()) }
model ProductAssignment { id String @id @default(uuid()); productId String; websiteId String; placement String @default("article-footer"); priority Int @default(50); weight Float @default(1); active Boolean @default(true); startsAt DateTime?; endsAt DateTime?; product Product @relation(fields:[productId],references:[id],onDelete:Cascade); website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); @@unique([productId,websiteId,placement]); @@index([websiteId,placement,active]) }
model CarouselPlacement { id String @id @default(uuid()); websiteId String; key String; title String @default("Recommended Products"); limit Int @default(30); active Boolean @default(true); website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); @@unique([websiteId,key]) }
model AnalyticsEvent { id String @id @default(uuid()); websiteId String; productId String?; eventType EventType; sessionId String?; placement String?; position Int?; metadata Json?; createdAt DateTime @default(now()); website Website @relation(fields:[websiteId],references:[id],onDelete:Cascade); product Product? @relation(fields:[productId],references:[id],onDelete:SetNull); @@index([websiteId,eventType,createdAt]); @@index([productId,eventType,createdAt]) }
model ProductScore { id String @id @default(uuid()); productId String @unique; ctr Float @default(0); conversionRate Float @default(0); profitScore Float @default(0); relevanceScore Float @default(0); inventoryScore Float @default(0); finalScore Float @default(0); product Product @relation(fields:[productId],references:[id],onDelete:Cascade); updatedAt DateTime @updatedAt }
model SyncJob { id String @id @default(uuid()); supplierId String?; type String; status String; cursor String?; processed Int @default(0); failures Int @default(0); details Json?; startedAt DateTime @default(now()); completedAt DateTime?; @@index([status,startedAt]) }
