{
  "name": "chambelli-commerce",
  "private": true,
  "version": "0.2.0",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:api": "pnpm --filter @chambelli/api dev",
    "dev:admin": "pnpm --filter @chambelli/admin dev",
    "dev:worker": "pnpm --filter @chambelli/worker dev",
    "dev:edge": "pnpm --filter @chambelli/edge dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:push": "prisma db push --skip-generate"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.3",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
